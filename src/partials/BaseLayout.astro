---
const { seoConfig, lang = "en" } = Astro.props;
const dir = lang === "ar" ? "rtl" : "ltr";
const locales: Record<string, string> = {
  en: "en_US",
  ar: "ar_AR",
  es: "es_ES",
  fr: "fr_FR",
  hi: "hi_IN",
  zh: "zh_CN",
};
const site = "https://www.pdfequips.com";
const pageUrl = `${site}${lang === "en" ? "" : `/${lang}`}${seoConfig.to}`;
const hreflangs = ["ar", "es", "fr", "hi", "zh"];

import { Schema } from "astro-seo-schema";
import "../styles/global.css";
import "../../index.scss";
import Navbar from "pdfequips-navbar/NavBar";
import { MarkdownToPDFHOWTO } from "../how-to";
import AstroSeo from "./AstroSeo.astro";
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <AstroSeo {...{ ...seoConfig, title: seoConfig.seoTitle }} />
    <Schema item={MarkdownToPDFHOWTO} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={`${site}${seoConfig.to}`} />
    {
      hreflangs.map((l) => (
        <link rel="alternate" hreflang={l} href={`${site}/${l}${seoConfig.to}`} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${site}${seoConfig.to}`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={seoConfig.seoTitle} />
    <meta property="og:description" content={seoConfig.description} />
    <meta property="og:locale" content={locales[lang] ?? "en_US"} />
    <meta property="og:site_name" content="PDFEquips" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FC271C" />
    <link rel="icon" type="image/svg+xml" href="/images/icons/logo.svg" />
    <slot name="head" />
  </head>
  <body>
    <main>
      <Navbar
        client:load
        lang={lang === "en" ? "" : lang}
        path={seoConfig.to.replace("/", "")}
        shadow={false}
      />
      <slot />
    </main>
  </body>
</html>
